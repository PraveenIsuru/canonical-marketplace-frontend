# The Laravel API. Both must point at the running backend.
# NEXT_PUBLIC_API_URL is used in the browser, API_URL on the server.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Shared secret for the revalidation webhook the backend calls on version creation.
# Must match the value configured in the backend.
REVALIDATE_SECRET=change-me-in-local-and-production

# Map tiles for store location display and manual pin placement.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# No AI provider key belongs in this file. Every AI call originates from the Laravel
# service, which keeps provider credentials out of the frontend entirely.

# This application's own public origin. Canonical URLs, Open Graph tags, and robots.txt
# are resolved against it, so a wrong value publishes wrong URLs to crawlers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
